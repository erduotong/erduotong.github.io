---
import BaseHead from '@/components/astro/BaseHead.astro'
import '../styles/global.css'
import DarkModeAdapter from '@/components/astro/DarkModeAdapter.astro'
import Footer from '@/components/astro/Footer.astro'
import Header from '@/components/astro/Header.astro'
import SkipToMainContent from '@/components/astro/SkipToMainContent.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/const.ts'

interface Props {
	// 有title就拼接为 title | SITE_TITLE
	// 没有则就 SITE_TITLE
	title?: string
	description: string
}
const title = Astro.props.title
	? `${Astro.props.title} | ${SITE_TITLE} `
	: SITE_TITLE
---
<!doctype html>
<html lang="zh">
    <!--suppress HtmlRequiredTitleElement -->
    <head>
        <BaseHead title={title} description={Astro.props.description}></BaseHead>
        <DarkModeAdapter></DarkModeAdapter>
    </head>
    <body>
        <SkipToMainContent href="#main-content"></SkipToMainContent>
        <Header></Header>
        <main>
            <slot />
        </main>
        <Footer></Footer>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }
</style>
