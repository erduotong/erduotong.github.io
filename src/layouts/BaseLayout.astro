---
import BaseHead from '@/components/astro/BaseHead.astro'
import '../styles/global.css'
import DarkModeAdapter from '@/components/astro/DarkModeAdapter.astro'
import Footer from '@/components/astro/Footer.astro'
import Header from '@/components/astro/Header.astro'
import SkipToMainContent from '@/components/astro/SkipToMainContent.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/const.ts'
---
<!doctype html>
<html lang="zh">
    <!--suppress HtmlRequiredTitleElement -->
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}></BaseHead>
        <DarkModeAdapter></DarkModeAdapter>
    </head>
    <body>
        <SkipToMainContent href="#main-content"></SkipToMainContent>
        <Header></Header>
        <!--todo 这里不一定是main content 要改逻辑-->
        <main id="main-content">
            <slot />
        </main>
        <Footer></Footer>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }
</style>
