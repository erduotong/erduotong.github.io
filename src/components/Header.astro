---
import { Image } from 'astro:assets'
import logo from '@/assets/logo.png'
import DarkSwitcher from './DarkSwitcher.vue'
import MobileMenu from './MobileMenu.vue'
---

<header class="sticky top-0 h-header-height">
    <div class="w-full mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3 h-full">
        <!--Left-->
        <div class="flex items-center gap-1.5 lg:flex-1  ">
            <a href="/" class="flex items-center gap-1.5 text-muted-foreground hover:text-primary">
                <Image src={logo} alt="Logo" class="h-10 w-10 mx-1" loading={'eager'} />
                <p class="font-medium text-xl transition-all ease-out duration-100">耳朵同的小站</p>
            </a>
        </div>

        <!--Middle-->
        <div class="hidden lg:flex">
            Navigator
        </div>

        <!--Right-->
        <div class="flex items-center justify-end gap-1.5 lg:flex-1">
            <DarkSwitcher client:load></DarkSwitcher>
            <MobileMenu client:load></MobileMenu>
        </div>
    </div>

</header>