---
interface Props {
	href: string
}
---
<a href={Astro.props.href} class="fixed z-50 left-1/2 top-2 rounded-full shadow-lg bg-primary
        text-primary-foreground px-4 py-2 text-sm font-medium transition-all duration-200 ease-out skip-to-main-content">
    Skip To Main Content
</a>

<style>
    .skip-to-main-content {
        transform: translate(-50%, calc(-100% - 4rem));
        opacity: 0;
    }

    .skip-to-main-content:focus {
        transform: translate(-50%, 0);
        opacity: 1;
        outline: 2px solid var(--ring);
        outline-offset: 2px;
    }

</style>