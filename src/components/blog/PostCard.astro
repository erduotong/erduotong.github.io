---
import FormattedDate from '@/components/common/FormattedDate.astro'

interface Props {
	slug: string
	title: string
	description: string
	pubDate: Date
}

const { slug, title, description, pubDate } = Astro.props
---

<a href={`/blog/${slug}/`} class="block group">
    <div
            class="rounded-lg border border-border bg-card text-card-foreground shadow-sm transition-colors group-hover:border-primary"
    >
        <div class="flex flex-col gap-1.5 p-6">
            <h3 class="text-2xl font-semibold leading-none tracking-tight">
                {title}
            </h3>

            <p class="text-sm text-muted-foreground">{description}</p>

        </div>

        <div class="flex items-center justify-between p-6 pt-0 text-sm text-muted-foreground">
            <FormattedDate date={pubDate} />
        </div>
    </div>
</a>